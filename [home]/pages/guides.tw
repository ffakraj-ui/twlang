            div { class "docs-sidebar-section"
                h3 "Guides & Tutorials"

                a "Migration Guide" { class "docs-sidebar-link docs-sidebar-link-active", href "/guides" }

                a "Mobile Development" { class "docs-sidebar-link docs-sidebar-link-active", href "/guides" }

                a "E-Commerce Template Guide" { class "docs-sidebar-link docs-sidebar-link-active", href "/guides" }

