                a "Service Workers and PWA" { class "docs-sidebar-link", href "/advanced" }

                a "Lazy Loading" { class "docs-sidebar-link", href "/advanced" }

            }

            div { class "docs-sidebar-section"
                h3 "Reference"

                a "SEO and Meta Tags" { class "docs-sidebar-link", href "/reference" }

                a "Built-in Search" { class "docs-sidebar-link", href "/reference" }

                a "Environment Variables" { class "docs-sidebar-link", href "/reference" }

                a "Build Pipeline" { class "docs-sidebar-link", href "/reference" }

                a "TW Config Reference" { class "docs-sidebar-link", href "/reference" }

