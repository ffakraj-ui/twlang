                a "Internationalization (i18n)" { class "docs-sidebar-link docs-sidebar-link-active", href "/guides" }

                a "Accessibility Guide" { class "docs-sidebar-link docs-sidebar-link-active", href "/guides" }

                a "Tutorial: Building a Blog" { class "docs-sidebar-link docs-sidebar-link-active", href "/guides" }

                a "Tutorial: Building a Docs Site" { class "docs-sidebar-link docs-sidebar-link-active", href "/guides" }

            }

        }

        div { class "docs-content"
            div { class "docs-header"
                h1 "📚 Guides & Tutorials"
                p "Templates, migration, tutorials"
            }
            div { class "docs-grid"

                div { class "docs-card"
                    h3 "Migration Guide"
                    p "TW's syntax is HTML-like, so migration is straightforward: <div class='card'> <h1>Hello World</h1> <p>Welcome to my site..."
                }

                div { class "docs-card"
                    h3 "Mobile Development"
                    p "TW Framework is the only web framework designed to work on mobile devices. - **Python-based** — runs on Termux (Android)"
                }

                div { class "docs-card"
                    h3 "E-Commerce Template Guide"
                    p "Complete e-commerce site using TW Framework. my-store/ ├── [home]/ │   ├── pages/ │   │   ├── index.tw              → Ho..."
                }

                div { class "docs-card"
                    h3 "SaaS Landing Page Template"
                    p "page { title 'MyApp - Build Better', layout 'main', render static } body { section { class 'hero' h1 'Build Better Apps,..."
                }

                div { class "docs-card"
                    h3 "Internationalization (i18n)"
                    p "`[home]/data/translations/en.json`: { 'home.title': 'Welcome', 'nav.about': 'About' } `[home]/data/translations/hi.json`..."
                }

